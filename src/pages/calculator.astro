---
import Layout from "../layouts/Layout.astro";
import CurrencyCalculator from "../components/CurrencyCalculator";

const baseUrl = import.meta.env.BCV_BACKEND_URL;
let rates = { list: [], bcv_date: "" };
let binance = null;

if (baseUrl) {
  const ratesRes = await fetch(`${baseUrl}/rates`, { cache: "no-store" });
  rates = ratesRes.ok ? await ratesRes.json() : { list: [], bcv_date: "" };

  const binanceRes = await fetch(`${baseUrl}/binance`, { cache: "no-store" });
  binance = binanceRes.ok ? await binanceRes.json() : null;
}
---

<Layout>
  <div class="flex w-full justify-center px-6 py-14 sm:py-20">
    <CurrencyCalculator rates={rates} binance={binance} client:load />
  </div>
</Layout>
