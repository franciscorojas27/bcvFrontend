---
import Layout from "../layouts/Layout.astro";
import PriceTable from "../components/PriceTable";
import CalculatorLauncher from "../components/CalculatorLauncher";

const baseUrl = import.meta.env.BCV_BACKEND_URL;
let rates = { list: [], bcv_date: "" };
let binance = null;

if (baseUrl) {
  const [ratesRes, binanceRes] = await Promise.all([
    fetch(`${baseUrl}/rates`, { cache: "no-store" }),
    fetch(`${baseUrl}/binance`, { cache: "no-store" }),
  ]);

  rates = ratesRes.ok ? await ratesRes.json() : { list: [], bcv_date: "" };
  binance = binanceRes.ok ? await binanceRes.json() : null;
}
---

<Layout>
  <div class="relative flex flex-1 items-center justify-center overflow-hidden px-6 py-10 sm:py-14">
    <div class="relative z-10 w-full">
      <PriceTable rates={rates} client:load />
    </div>
    <CalculatorLauncher rates={rates} binance={binance} client:load />
  </div>
</Layout>
